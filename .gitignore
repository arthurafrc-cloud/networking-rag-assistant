# ---------------------------------------------------------------
# Segredos: nunca versionar
# ---------------------------------------------------------------
.env
.env.*
!.env.example
.streamlit/secrets.toml

# ---------------------------------------------------------------
# Material de estudo e dados derivados dele
# A origem e a permissão de uso do PDF ainda não foram confirmadas,
# então nem o PDF nem nada gerado a partir dele vai para o repositório.
# ---------------------------------------------------------------
data/*
!data/.gitkeep

# Índice vetorial (FAISS). Contém trechos do PDF e é serializado com pickle.
vector_db/*
!vector_db/.gitkeep
*.faiss
*.pkl

# Resultados dos testes de comportamento (contêm respostas e trechos do PDF)
tests/resultados/

# ---------------------------------------------------------------
# Python e sistema
# ---------------------------------------------------------------
__pycache__/
*.pyc
.venv/
venv/
.DS_Store
Thumbs.db
